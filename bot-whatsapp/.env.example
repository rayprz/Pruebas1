# Copia este archivo a .env (o configura las variables en tu plataforma de deploy)

# ── WhatsApp Business Cloud API (Meta) ─────────────────────────────
WHATSAPP_TOKEN=            # Token permanente de usuario de sistema (Meta Business)
WHATSAPP_PHONE_ID=         # ID del número de teléfono (no es el número, es el ID)
VERIFY_TOKEN=rincon-abuela-2026   # Inventa uno; se usa al registrar el webhook en Meta
META_APP_SECRET=           # (Opcional) App secret para validar firmas del webhook
GRAPH_URL=https://graph.facebook.com/v23.0

# ── Anthropic (cerebro del bot) ────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelo por defecto. Para abaratar ~5x los costos puedes usar: claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# ── Mercado Pago (cobros en México) ────────────────────────────────
MP_ACCESS_TOKEN=           # Access token de PRODUCCIÓN de tu aplicación
MP_WEBHOOK_SECRET=         # Secreto de webhooks (sección Webhooks de tu app en MP)

# ── Negocio ────────────────────────────────────────────────────────
OWNER_WHATSAPP=            # Tu número con código de país, ej. 5215512345678
PRECIO_MXN=99
PUBLIC_URL=                # URL pública del bot ya desplegado, ej. https://miapp.up.railway.app

# ── Rutas (los defaults funcionan dentro del repo) ─────────────────
# PDF_PATH=../productos/01-recetario-cocina-de-antano/recetario.pdf
# DB_PATH=rincon.db
