# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).

# --- Database ---------------------------------------------------------------
# Postgres credentials used by the docker-compose `db` service. The app's
# DATABASE_URL is built from these inside docker-compose (host "db"), so you do
# NOT need to set DATABASE_URL for the Docker stack.
POSTGRES_USER="fleet"
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB="fleet"

# Only for running the app WITHOUT Docker (local dev against a local Postgres):
DATABASE_URL="postgresql://fleet:fleet@localhost:5432/fleet?schema=public"
# Direct (unpooled) URL used by `prisma migrate`. Same as DATABASE_URL when
# there is no pooler (local / Docker). On managed Postgres with pooling (Neon),
# set DATABASE_URL to the POOLED string and DIRECT_URL to the DIRECT string.
DIRECT_URL="postgresql://fleet:fleet@localhost:5432/fleet?schema=public"

# --- Auth (Auth.js / NextAuth v5) -------------------------------------------
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Public URL the app is served from (used for callbacks). e.g. https://fleet.corp.local
AUTH_URL="http://localhost:3000"
# Trust the host header behind the corporate reverse proxy / load balancer.
AUTH_TRUST_HOST="true"

# Seed credentials for the first admin user (used once by `npm run db:seed`).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# --- Frontend ---------------------------------------------------------------
# API base for client fetches. Empty = same origin (recommended). Set only if
# the API is served from a different host.
NEXT_PUBLIC_API_BASE=""

# --- SSO / OIDC (optional — fill in when IT provides an IdP) -----------------
# Supported out of the box: Microsoft Entra ID, Okta, Google (all OIDC).
# Leaving these empty keeps the username/password login active.
# AUTH_OIDC_ISSUER=""
# AUTH_OIDC_CLIENT_ID=""
# AUTH_OIDC_CLIENT_SECRET=""
